# Template for a root-readable runtime environment file. Do not reuse a prior
# run's feed/revision epochs or calculation run IDs.
L2FLOW_START_MODE=partial
L2FLOW_TRADE_DATE=YYYYMMDD
L2FLOW_CATALOG=/absolute/path/to/production-catalog.csv
L2FLOW_MDL_USER=REPLACE_WITH_MDL_USER
L2FLOW_CLICKHOUSE_USER=default
L2FLOW_CLICKHOUSE_PASSWORD=

# Dedicated local SSD/NVMe path. This first implementation truncates the file
# on startup and relies on durable raw ClickHouse data for rebuild/replay.
L2FLOW_FACT_JOURNAL_PATH=/absolute/path/on/dedicated-storage/facts-current.fjn

# Stable for one logical raw source across restarts.
L2FLOW_SOURCE_INSTANCE_HEX32=REPLACE_WITH_STABLE_32_HEX_SOURCE_ID

# One process epoch identifies raw facts, derived dispatches, and Arrow batches.
# It must not be reused for the source and must exceed the Arrow root manifest.
L2FLOW_FEED_EPOCH=REPLACE_WITH_NEW_NONZERO_UINT64

# Durably allocated, strictly increasing epochs for each derived key space.
# Generate a new nonzero 32-hex calculation ID for every calculation run.
L2FLOW_EVENT_REVISION_EPOCH=REPLACE_WITH_NEW_NONZERO_UINT32
L2FLOW_EVENT_RUN_HEX32=REPLACE_WITH_NEW_32_HEX_RUN_ID
L2FLOW_KLINE_INTERVAL_SECONDS=1
L2FLOW_KLINE_REVISION_EPOCH=REPLACE_WITH_NEW_NONZERO_UINT32
L2FLOW_KLINE_RUN_HEX32=REPLACE_WITH_NEW_32_HEX_RUN_ID
